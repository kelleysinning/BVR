
  model {

   # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   # cut-points
   # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   for (j in 1:K){
     for (k in 1:C){
       theta.star[j,k] ~ dnorm(0, 0.01)
     }
     theta[j,1:C] <- sort(theta.star[j,1:C])
   }
   
   # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   # ordered logit model for survey responses
   # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   beta[1] ~ dnorm(0, 0.1)
   beta[2] = -1
   beta[3] ~ dnorm(0, 0.1)
   sigma ~ dgamma(3,1)
   tau = pow(sigma, -2)
   
   for (i in 1:n){
     eta[i] ~ dnorm(0, tau)
     
     for (j in 1:K){
       mu[i,j] <- beta[j] * eta[i]
       S[i,j] ~ dordered.logit(mu[i,j], theta[j,1:C])
     }

   } 


   # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   # inhomogeneous point process
   # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   alpha[1] ~ dnorm(0, 1)
   alpha[2] ~ dnorm(0, 1) T(0,)
   alpha[3] ~ dnorm(0, 1)
   for (i in 1:n){
     log(lambda[i]) = alpha[1] + alpha[2] * eta[i] + alpha[3] * x[i]
     y[i] ~ dpois(lambda[i])
   }


      
  }
  
